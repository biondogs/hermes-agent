model:
  default: qwen38-flash-fp8
  provider: custom:LiteLLM
  max_tokens: 65536
  context_length: 262144
auxiliary:
  vision:
    model: qwen38-flash-fp8
    provider: custom:LiteLLM
  compression:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  web_extract:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  approval:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  mcp:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  title_generation:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  memory_query_rewrite:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  tts_audio_tags:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  skills_hub:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  triage_specifier:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  kanban_decomposer:
    model: qwen38-flash-fp8
    reasoning_effort: medium
    provider: custom:LiteLLM
  profile_describer:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
  curator:
    model: qwen38
    reasoning_effort: none
    provider: custom:LiteLLM
agent:
  description: General-purpose kanban worker for fallback task execution. Lightweight, handles any task type. Used as default_assignee when no specialist profile is specified.. For the software-co board prefer the sw-* staff profiles (sw-pm, sw-architect, sw-dev-a/b, sw-reviewer, sw-qa, sw-devops, sw-docs).
  max_turns: 200
  reasoning_effort: medium
  disabled_toolsets:
    - discord
    - discord_admin
    - feishu_doc
    - feishu_drive
    - homeassistant
    - spotify
    - video
    - video_gen
    - x_search
    - yuanbao
    - tts
    - computer_use
toolsets:
  - file
  - terminal
  - code_execution
  - web
  - todo
  - memory
  - session_search
  - kanban
compression:
  protect_last_n: 50
display:
  show_reasoning: true
memory:
  provider: hindsight
  budget: mid
approvals:
  deny:
    - git push --force*
    - git reset --hard*
    - rm -rf /*
    - rm -rf ~/*
providers:
  litellm:
    api: https://orb.arch.jhu.edu/v1
    name: LiteLLM
    api_key: ${LITELLM_API_KEY}
    models:
      qwen38-flash-fp8:
        context_length: 262144
      qwen38:
        context_length: 1000000
      nemo-fp4:
        context_length: 1000000
      gemma4-fp4:
        context_length: 262144
    ssl_verify: false
    transport: chat_completions
plugins:
  enabled:
    - hindsight
  disabled: []
_config_version: 51

# ── Security ──────────────────────────────────────────────────────────
# Secret redaction is ON by default — strings that look like API keys,
# tokens, and passwords are masked in tool output, logs, and chat
# responses before the model or user ever sees them. Set redact_secrets
# to false to disable (e.g. when developing the redactor itself).
# tirith pre-exec scanning is enabled by default when the tirith binary
# is available. Configure via security.tirith_* keys or env vars
# (TIRITH_ENABLED, TIRITH_BIN, TIRITH_TIMEOUT, TIRITH_FAIL_OPEN).
#
# security:
#   redact_secrets: true
#   tirith_enabled: true
#   tirith_path: "tirith"
#   tirith_timeout: 5
#   tirith_fail_open: true

# ── Fallback Model ────────────────────────────────────────────────────
# Automatic provider failover when primary is unavailable.
# Uncomment and configure to enable. Triggers on rate limits (429),
# overload (529), service errors (503), or connection failures.
#
# Supported providers:
#   openrouter   (OPENROUTER_API_KEY)  — routes to any model
#   openai-codex (OAuth — hermes auth) — OpenAI Codex
#   nous         (OAuth — hermes auth) — Nous Portal
#   zai          (ZAI_API_KEY)         — Z.AI / GLM
#   kimi-coding  (KIMI_API_KEY)        — Kimi / Moonshot
#   kimi-coding-cn (KIMI_CN_API_KEY)   — Kimi / Moonshot (China)
#   minimax      (MINIMAX_API_KEY)     — MiniMax
#   minimax-cn   (MINIMAX_CN_API_KEY)  — MiniMax (China)
#   bedrock      (AWS IAM / boto3)     — AWS Bedrock (Converse API)
#
# For custom OpenAI-compatible endpoints, add base_url and key_env.
#
# fallback_model:
#   provider: openrouter
#   model: anthropic/claude-sonnet-4
