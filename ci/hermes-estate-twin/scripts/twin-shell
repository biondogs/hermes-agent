#!/bin/bash
# twin-shell — open a shell in the twin container
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TWIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
if ! docker ps --format '{{.Names}}' | grep -qx "hermes-estate-twin"; then
  echo "Twin container not running. Starting..." >&2
  docker compose -f "$TWIN_DIR/docker-compose.yml" up -d
  echo "Waiting for twin to be ready..." >&2
  sleep 3
fi
if [ -f "$TWIN_DIR/twin-root/.quarantined" ]; then
  echo "WARNING: twin is quarantined (scanner hit). Shell still allowed for inspection." >&2
fi
exec docker exec -it hermes-estate-twin bash "$@"
