 from __future__ import annotations
 
+import fcntl
 import itertools
 import json
 import os
@@ -46,6 +47,36 @@ class StateLogCorrupt(Exception):
     """The append-only log is corrupt where no torn-tail explanation exists."""
 
 
+class StateDirLocked(Exception):
+    """Another process (a server) owns this state dir; direct opens refuse (QA-001)."""
+
+
+LOCK_NAME = ".lock"
+
+
+class StateDirLock:
+    """Advisory ``flock`` on ``<state>/.lock``.
+
+    ``serve`` holds it exclusively for its lifetime; every other opener only
+    probes (shared, non-blocking, released at once) and refuses by name.
+    """
+
+    def __init__(self, base: Path, *, hold: bool) -> None:
+        self._fd: int | None = os.open(base / LOCK_NAME, os.O_RDWR | os.O_CREAT, 0o644)
+        try:
+            fcntl.flock(self._fd, (fcntl.LOCK_EX if hold else fcntl.LOCK_SH) | fcntl.LOCK_NB)
+        except OSError as exc:
+            self.release()
+            raise StateDirLocked("state-dir-locked (a server owns it — pass --url)") from exc
+        if not hold:
+            self.release()
+
+    def release(self) -> None:
+        if self._fd is not None:
+            os.close(self._fd)  # closing the fd drops the flock
+            self._fd = None
+
+
 @dataclass(frozen=True)
 class TransitionRecord:
     """An attributed state transition — including every rewind (I2)."""
