#!/bin/bash
# twin-test — run estate test suite inside the twin container
# Usage: twin-test [pytest args...]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TWIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -f "$TWIN_DIR/twin-root/.quarantined" ]; then
  echo "ERROR: twin is quarantined — fix scrub/scan before testing" >&2
  exit 2
fi
if ! docker ps --format '{{.Names}}' | grep -qx "hermes-estate-twin"; then
  echo "Starting twin container..." >&2
  docker compose -f "$TWIN_DIR/docker-compose.yml" up -d
  sleep 3
fi

# Default: run hermes-agent test suite; pass custom args through.
# The twin sits on an internal:true network, so run_tests.sh's own
# run-in-hermes-env path (stages pinned uv from GitHub) cannot work there.
# When offline, hand run_tests.sh the image's baked interpreter via
# HERMES_PYTHON: it then skips uv staging and runs its hermetic per-file
# runner offline (card t_42ab1cec; docs/CI-CONTAINERS-GUIDANCE.md §5a).
# NOTE: this tests the twin checkout's WORK TREE as it stands (other cards may
# have edited it). To test a specific ref, use scripts/twin-clone-test.
if [ $# -eq 0 ]; then
  docker exec hermes-estate-twin bash -c '
    set -e
    cd /opt/twin/hermes-agent
    echo "twin-test: surface=in-twin host=$(hostname) interpreter=/usr/bin/python3 head=$(git rev-parse HEAD) dirty_files=$(git status --porcelain | wc -l)"
    if [ -f scripts/run_tests.sh ]; then
      if getent hosts github.com >/dev/null 2>&1; then
        bash scripts/run_tests.sh 2>&1 | tail -40
      else
        echo "twin-test: offline (internal network) -> HERMES_PYTHON=/usr/bin/python3 run_tests.sh (no uv staging)"
        env -u HERMES_HOME HERMES_PYTHON=/usr/bin/python3 bash scripts/run_tests.sh 2>&1 | tail -40
      fi
    else
      /usr/bin/python3 -m pytest tests/ -x -q 2>&1 | tail -40
    fi
  '
  echo "=== twin-test: twin-tools suite ===" >&2
  docker exec hermes-estate-twin bash -c '
    set -e
    if [ -d /opt/twin-tools/tests ]; then
      echo "Running twin-tools tests inside twin..."
      python3 -m unittest discover -s /opt/twin-tools/tests -v 2>&1 | tail -30
    else
      echo "No twin-tools tests found at /opt/twin-tools/tests"
    fi
  '
  echo "=== twin-test: mock-model + fake-telegram probe ===" >&2
  docker exec hermes-estate-twin bash -c '
    echo "Checking mock-model at http://mock-model:8080/health..."
    python3 -c "
import urllib.request, json
for url in [\"http://mock-model:8080/health\", \"http://fake-telegram:8081/health\"]:
    try:
        with urllib.request.urlopen(url, timeout=3) as r:
            print(f\"  OK {url}: {r.read().decode()[:80]}\")
    except Exception as e:
        print(f\"  FAIL {url}: {e}\")
"
  '
  # Regression guard for twin-eval.sh early-exit typo class (R1 item 1)
  echo "=== twin-test: twin-eval.sh smoke test ===" >&2
  TMPHOME=$(mktemp -d)
  if HOME="$TMPHOME" bash "$TWIN_DIR/scripts/twin-eval.sh" 2>&1 | grep -q "skipped: key not provisioned"; then
    echo "  PASS twin-eval.sh missing-key smoke test"
  else
    echo "  FAIL twin-eval.sh missing-key smoke test"
    rm -rf "$TMPHOME"
    exit 1
  fi
  rm -rf "$TMPHOME"
else
  docker exec hermes-estate-twin bash -c "cd /opt/twin/hermes-agent && $*"
fi
